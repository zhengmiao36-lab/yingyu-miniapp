page {
  --bg: #090a0a;
  --surface: #111311;
  --surface-2: #181a17;
  --gold: #d6b66f;
  --gold-strong: #e7c978;
  --gold-dim: #7a6941;
  --text: #f4efe4;
  --text-soft: #b9b2a3;
  --muted: #777368;
  --border: #4a4029;
  --wine: #5a3038;
  --blue: #334653;
  --slate: #4c555d;
  --success: #2fc477;
  min-height: 100%;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

view,
text,
button,
input,
scroll-view {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  font: inherit;
}

button::after {
  border: 0;
}

.page-shell {
  min-height: 100vh;
  padding: 20rpx 24rpx 36rpx;
  background-color: var(--bg);
  background-image:
    radial-gradient(circle at 18% 12%, rgba(109, 86, 43, 0.15), transparent 34%),
    radial-gradient(circle at 82% 66%, rgba(72, 34, 39, 0.12), transparent 30%);
}

.surface {
  background: rgba(17, 19, 17, 0.96);
  border: 1rpx solid var(--border);
  border-radius: 8rpx;
}

.section-title {
  margin: 28rpx 4rpx 16rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
}

.muted {
  color: var(--muted);
}

.soft {
  color: var(--text-soft);
}

.gold {
  color: var(--gold);
}

.pressable {
  transition: opacity 180ms ease, background-color 180ms ease, border-color 180ms ease;
}

.pressable:active {
  opacity: 0.72;
}

.primary-button {
  min-width: 96rpx;
  min-height: 88rpx;
  padding: 0 28rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 36rpx;
  background: var(--gold-strong);
  color: #211a0c;
  font-weight: 700;
  line-height: 1;
}

.outline-button {
  min-height: 88rpx;
  padding: 0 24rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--gold-dim);
  border-radius: 8rpx;
  background: transparent;
  color: var(--gold);
  font-weight: 600;
}

.eyebrow {
  color: var(--gold);
  font-size: 24rpx;
  line-height: 1.2;
  letter-spacing: 0;
}

.empty-state {
  padding: 80rpx 32rpx;
  text-align: center;
  color: var(--text-soft);
}

@media (prefers-reduced-motion: reduce) {
  .pressable {
    transition: none;
  }
}
