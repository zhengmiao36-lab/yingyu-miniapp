.detail-page {
  padding-top: 18rpx;
}

.profile-summary {
  margin-top: 18rpx;
  padding: 24rpx 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.profile-summary__name,
.profile-summary__role,
.profile-summary__points {
  display: block;
}

.profile-summary__name {
  font-size: 38rpx;
  font-weight: 800;
}

.profile-summary__role {
  margin-top: 6rpx;
  color: var(--gold);
  font-size: 24rpx;
}

.profile-summary__score {
  flex: 0 0 auto;
  text-align: right;
}

.profile-summary__points {
  margin-top: 4rpx;
  color: var(--gold-strong);
  font-size: 40rpx;
  font-weight: 800;
}

.detail-section {
  margin-top: 18rpx;
  padding: 26rpx;
}

.detail-section__title,
.detail-section__body {
  display: block;
}

.detail-section__title {
  font-size: 31rpx;
  font-weight: 800;
}

.detail-section__body {
  margin-top: 14rpx;
  color: var(--text-soft);
  font-size: 26rpx;
  line-height: 1.75;
}

.role-tag {
  min-height: 52rpx;
  margin-top: 16rpx;
  padding: 0 18rpx;
  display: inline-flex;
  align-items: center;
  border: 1rpx solid var(--gold-dim);
  border-radius: 4rpx;
  background: rgba(214, 182, 111, 0.08);
  color: var(--gold);
}

.schedule-row {
  min-height: 102rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid rgba(116, 98, 61, 0.35);
}

.schedule-row:last-child {
  border-bottom: 0;
}

.schedule-row__label,
.schedule-row__time {
  display: block;
}

.schedule-row__label {
  font-size: 28rpx;
  font-weight: 700;
}

.schedule-row__time {
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.schedule-row__status {
  min-width: 118rpx;
  min-height: 88rpx;
  padding: 0 16rpx;
  border: 1rpx solid var(--gold-dim);
  border-radius: 32rpx;
  background: rgba(214, 182, 111, 0.08);
  color: var(--gold);
  font-size: 24rpx;
}

.schedule-row__status--disabled {
  border-color: #34342f;
  color: var(--muted);
}
