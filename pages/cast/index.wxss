.cast-page {
  padding-top: 4rpx;
  padding-right: 26rpx;
  padding-left: 26rpx;
}

.actor-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18rpx;
}

.actor-card {
  min-width: 0;
  overflow: hidden;
  transition: opacity 160ms ease, transform 180ms ease, border-color 180ms ease;
}

.actor-card--pressed {
  opacity: 0.82;
  transform: scale(0.985);
  border-color: var(--gold-dim);
}

.actor-card__copy {
  min-height: 102rpx;
  padding: 14rpx 12rpx 16rpx;
}

.actor-card__name,
.actor-card__role {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.actor-card__name {
  font-size: 26rpx;
  font-weight: 700;
}

.actor-card__role {
  margin-top: 6rpx;
  color: var(--gold);
  font-size: 24rpx;
}

@media (prefers-reduced-motion: reduce) {
  .actor-card {
    transition: none;
  }

  .actor-card--pressed {
    transform: none;
  }
}
