.order-detail-page {
  padding-top: 28rpx;
}

.order-detail-heading {
  padding: 8rpx 4rpx 20rpx;
}

.order-detail-heading__title,
.order-detail-heading__hint {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-detail-heading__title {
  margin-top: 8rpx;
  font-size: 42rpx;
  font-weight: 800;
}

.order-detail-heading__hint {
  margin-top: 6rpx;
  color: var(--text-soft);
  font-size: 24rpx;
}

.voucher {
  padding: 24rpx;
  text-align: center;
  background-image: linear-gradient(155deg, rgba(122, 93, 44, 0.28), transparent 58%);
}

.voucher__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.voucher__type,
.voucher__status,
.voucher__title,
.voucher__subtitle,
.voucher__instruction {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.voucher__type {
  color: var(--gold);
  font-size: 22rpx;
  font-weight: 700;
}

.voucher__status {
  color: var(--success);
  font-size: 23rpx;
  font-weight: 700;
}

.voucher__title,
.voucher__subtitle,
.voucher__instruction {
  display: block;
}

.voucher__title {
  margin-top: 28rpx;
  font-size: 34rpx;
  font-weight: 800;
}

.voucher__subtitle {
  margin-top: 7rpx;
  color: var(--text-soft);
  font-size: 23rpx;
}

.voucher__qr {
  width: 300rpx;
  height: 300rpx;
  margin: 26rpx auto 0;
  display: block;
  border: 12rpx solid #f7f4ed;
  background: #f7f4ed;
}

.voucher__code-wrap,
.voucher__pending {
  margin-top: 30rpx;
  padding: 24rpx 16rpx;
  border-top: 1rpx dashed rgba(214, 182, 111, 0.45);
  border-bottom: 1rpx dashed rgba(214, 182, 111, 0.45);
}

.voucher__code-label,
.voucher__code,
.voucher__pending-title,
.voucher__pending-copy {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.voucher__code-label,
.voucher__pending-copy {
  color: var(--text-soft);
  font-size: 22rpx;
}

.voucher__code {
  margin-top: 10rpx;
  color: var(--gold-strong);
  font-size: 52rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.voucher__pending-title {
  color: var(--gold);
  font-size: 29rpx;
  font-weight: 800;
}

.voucher__pending-copy {
  margin-top: 8rpx;
}

.voucher__instruction {
  margin-top: 22rpx;
  color: var(--muted);
  font-size: 21rpx;
}

.order-facts {
  margin-top: 18rpx;
  padding: 0 24rpx;
}

.order-fact {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 26rpx;
  border-bottom: 1rpx solid rgba(116, 98, 61, 0.3);
}

.order-fact:last-child {
  border-bottom: 0;
}

.order-fact__label,
.order-fact__value {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-fact__label {
  flex: 0 0 auto;
  color: var(--text-soft);
  font-size: 24rpx;
}

.order-fact__value {
  min-width: 0;
  color: var(--text);
  font-size: 24rpx;
  text-align: right;
}

.order-fact__value--gold {
  color: var(--gold-strong);
  font-weight: 800;
}

.voucher-action {
  width: 100%;
  margin-top: 16rpx;
  font-size: 25rpx;
}
