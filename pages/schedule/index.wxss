.schedule-page {
  padding-top: 18rpx;
}

.member-strip {
  position: relative;
  z-index: 2;
  min-height: 62rpx;
  margin: -76rpx 20rpx 14rpx;
  padding: 12rpx 18rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: rgba(9, 10, 10, 0.92);
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.28);
}

.member-strip__mark {
  width: 50rpx;
  height: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--gold-dim);
  border-radius: 17rpx;
  color: var(--gold);
  font-size: 18rpx;
  font-weight: 700;
}

.member-strip__text {
  color: #e8e1d3;
  font-size: 23rpx;
}

.week-switcher {
  min-height: 92rpx;
  margin-top: 18rpx;
  padding: 10rpx 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.week-switcher__button {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--gold-dim);
  border-radius: 8rpx;
  background: transparent;
  color: var(--gold);
  font-size: 36rpx;
  line-height: 1;
}

.week-switcher__button[disabled] {
  border-color: #282822;
  color: #44433c;
  opacity: 0.58;
}

.week-switcher__label {
  font-size: 34rpx;
  font-weight: 700;
}

.past-toggle {
  width: 100%;
  min-height: 88rpx;
  margin-top: 18rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--text-soft);
  font-size: 24rpx;
}

.past-toggle__copy {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.past-toggle__dot {
  width: 17rpx;
  height: 17rpx;
  border: 2rpx solid #817759;
  border-radius: 50%;
}

.past-toggle__action {
  color: var(--gold);
}

.day-card {
  margin-top: 18rpx;
  overflow: hidden;
}

.day-card--past {
  opacity: 0.78;
}

.day-card__header {
  min-height: 100rpx;
  padding: 20rpx 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid rgba(116, 98, 61, 0.34);
}

.day-card__date,
.day-card__weekday {
  display: block;
}

.day-card__date {
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.1;
}

.day-card__weekday {
  margin-top: 4rpx;
  color: var(--text-soft);
  font-size: 24rpx;
}

.day-card__badge,
.cast-count {
  min-height: 88rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid var(--gold-dim);
  border-radius: 27rpx;
  background: rgba(214, 182, 111, 0.06);
  color: var(--gold);
  font-size: 24rpx;
}

.session {
  padding: 20rpx 22rpx 24rpx;
  border-bottom: 1rpx solid rgba(116, 98, 61, 0.26);
}

.session:last-child {
  border-bottom: 0;
}

.session__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.session__time,
.session__status {
  display: block;
}

.session__time {
  font-size: 31rpx;
  font-weight: 800;
}

.session__status {
  margin-top: 4rpx;
  color: var(--text-soft);
  font-size: 24rpx;
}

.session__actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.session__left,
.session__sold {
  color: var(--text-soft);
  font-size: 24rpx;
}

.cast-grid {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
}

.cast-chip {
  min-height: 46rpx;
  padding: 7rpx 8rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 5rpx;
  color: #f1ede5;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 32rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cast-chip--wine { background: var(--wine); }
.cast-chip--blue { background: var(--blue); }
.cast-chip--slate { background: var(--slate); }
